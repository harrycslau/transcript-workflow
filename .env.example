# Copy to .env and fill in real values. Never commit .env.

# API key for the oMLX OpenAI-compatible endpoint (used by both the
# summary LLM and embeddings unless overridden per-section in config.yaml).
BRAIN_LLM_API_KEY=

# Optional: override the location of the YAML configuration file.
# BRAIN_CONFIG=/absolute/path/to/config.yaml

# Optional: override Django's secret key (local dev default is fine).
# BRAIN_DJANGO_SECRET_KEY=change-me
